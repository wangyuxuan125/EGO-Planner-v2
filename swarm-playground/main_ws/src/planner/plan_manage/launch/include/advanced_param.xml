<launch>
    <arg name="map_size_x_"/>
    <arg name="map_size_y_"/>
    <arg name="map_size_z_"/>
    <arg name="odometry_topic"/>
    <arg name="camera_pose_topic"/>
    <arg name="depth_topic"/>
    <arg name="cloud_topic"/>
    <arg name="cx"/>
    <arg name="cy"/>
    <arg name="fx"/>
    <arg name="fy"/>
    <arg name="max_vel"/>
    <arg name="max_acc"/>
    <arg name="max_jer"/>
    <arg name="planning_horizon"/>
    <arg name="point_num"/>
    <arg name="point0_x"/>
    <arg name="point0_y"/>
    <arg name="point0_z"/>
    <arg name="point1_x"/>
    <arg name="point1_y"/>
    <arg name="point1_z"/>
    <arg name="point2_x"/>
    <arg name="point2_y"/>
    <arg name="point2_z"/>
    <arg name="point3_x"/>
    <arg name="point3_y"/>
    <arg name="point3_z"/>
    <arg name="point4_x"/>
    <arg name="point4_y"/>
    <arg name="point4_z"/>
    <arg name="flight_type"/>
    <arg name="use_multitopology_trajs"/>
    <arg name="drone_id"/>
    <arg name="tf_sfc_enabled" default="false"/>
    <arg name="tf_sfc_corridor_method" default="obb"/>
    <arg name="tf_sfc_max_faces" default="12"/>
    <arg name="tf_sfc_max_obs_faces" default="6"/>
    <arg name="tf_sfc_max_inflation_distance" default="1.0"/>
    <arg name="tf_sfc_inflation_step" default="0.10"/>
    <arg name="tf_sfc_use_projection" default="true"/>
    <arg name="tf_sfc_use_soft_penalty" default="true"/>
    <arg name="tf_sfc_allow_partial_corridors" default="true"/>
    <arg name="tf_sfc_allow_ego_fallback" default="false"/>
    <arg name="tf_sfc_enforce_final_corridor" default="true"/>
    <arg name="tf_sfc_hard_corridor_parameterization" default="true"/>
    <arg name="tf_sfc_hard_max_vertices" default="64"/>
    <arg name="tf_sfc_hard_vertex_tolerance" default="0.0000001"/>
    <arg name="tf_sfc_max_enforcement_passes" default="2"/>
    <arg name="tf_sfc_enforcement_weight_multiplier" default="3.0"/>
    <arg name="tf_sfc_enforcement_min_improvement" default="0.00001"/>
    <arg name="tf_sfc_max_final_violation" default="0.001"/>
    <arg name="tf_sfc_visualization_enabled" default="true"/>
    <arg name="tf_sfc_visualization_frame" default="world"/>
    <arg name="tf_sfc_min_valid_pieces" default="1"/>
    <arg name="tf_sfc_safety_margin" default="0.10"/>
    <arg name="tf_sfc_min_overlap_radius" default="0.02"/>
    <arg name="tf_sfc_interior_sample_margin" default="0.0"/>
    <arg name="tf_sfc_junction_refine_radius" default="0.50"/>
    <arg name="tf_sfc_junction_refine_step" default="0.05"/>
    <arg name="tf_sfc_direction_mode" default="1"/>
    <arg name="tf_sfc_allow_direction_fallback" default="true"/>
    <arg name="tf_sfc_log_enabled" default="true"/>
    <arg name="tf_sfc_log_directory" default="$(env HOME)/tf_sfc_results/ego"/>
    <arg name="tf_sfc_experiment_tag" default="default"/>
    <arg name="tf_sfc_decomp_local_bbox_forward" default="0.5"/>
    <arg name="tf_sfc_decomp_local_bbox_lateral" default="1.0"/>
    <arg name="tf_sfc_decomp_local_bbox_vertical" default="1.0"/>
    <arg name="tf_sfc_decomp_overlap_extension" default="0.20"/>
    <arg name="tf_sfc_decomp_initial_velocity_segment" default="0.40"/>
    <arg name="tf_sfc_decomp_initial_velocity_threshold" default="0.20"/>
    <arg name="tf_sfc_decomp_degenerate_seed_length" default="0.10"/>
    <arg name="tf_sfc_decomp_retry_seed_validation_without_velocity" default="true"/>
    <arg name="tf_sfc_seed_retry_without_velocity_on_clearance_failure" default="true"/>
    <arg name="tf_sfc_seed_clearance_astar_enabled" default="true"/>
    <arg name="tf_sfc_seed_clearance_astar_time_limit" default="0.20"/>
    <arg name="tf_sfc_trajectory_repair_enabled" default="true"/>
    <arg name="tf_sfc_trajectory_repair_seed_fallback_enabled" default="true"/>
    <arg name="tf_sfc_trajectory_repair_seed_geometric_acceptance_enabled" default="true"/>
    <arg name="tf_sfc_trajectory_repair_max_passes" default="1"/>
    <arg name="tf_sfc_post_optimization_repair_enabled" default="true"/>
    <arg name="tf_sfc_post_optimization_repair_max_passes" default="1"/>
    <arg name="tf_sfc_post_optimization_repair_max_seed_junction_shift" default="0.25"/>
    <arg name="tf_sfc_trajectory_repair_trigger" default="0.001"/>
    <arg name="tf_sfc_trajectory_repair_min_improvement" default="0.0001"/>
    <!-- main node -->
    <!-- <node pkg="ego_planner" name="ego_planner_node" type="ego_planner_node" output="screen" launch-prefix="valgrind"> -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_ego_planner_node" type="ego_planner_node" output="screen">
        <remap from="~odom_world" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~mandatory_stop" to="/mandatory_stop_to_planner"/>
        <remap from="~planning/trajectory" to = "/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/data_display" to = "/drone_$(arg drone_id)_planning/data_display"/>
        <remap from="~planning/broadcast_traj_send" to = "/broadcast_traj_from_planner"/>
        <remap from="~planning/broadcast_traj_recv" to = "/broadcast_traj_to_planner"/>
        <remap from="~planning/heartbeat" to = "/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <remap from="/goal" to = "/goal_with_id"/>
        <remap from="~grid_map/odom" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~grid_map/cloud" to="/drone_$(arg drone_id)_$(arg cloud_topic)"/>
        <remap from="~grid_map/pose"   to = "/drone_$(arg drone_id)_$(arg camera_pose_topic)"/>
        <remap from="~grid_map/depth" to = "/drone_$(arg drone_id)_$(arg depth_topic)"/>
        <!-- planning fsm -->
        <param name="fsm/flight_type" value="$(arg flight_type)" type="int"/>
        <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
        <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <!--always set to 1.5 times grater than sensing horizen-->
        <param name="fsm/emergency_time" value="1.0" type="double"/>
        <param name="fsm/realworld_experiment" value="false"/>
        <param name="fsm/fail_safe" value="true"/>
        <param name="fsm/waypoint_num" value="$(arg point_num)" type="int"/>
        <param name="fsm/waypoint0_x" value="$(arg point0_x)" type="double"/>
        <param name="fsm/waypoint0_y" value="$(arg point0_y)" type="double"/>
        <param name="fsm/waypoint0_z" value="$(arg point0_z)" type="double"/>
        <param name="fsm/waypoint1_x" value="$(arg point1_x)" type="double"/>
        <param name="fsm/waypoint1_y" value="$(arg point1_y)" type="double"/>
        <param name="fsm/waypoint1_z" value="$(arg point1_z)" type="double"/>
        <param name="fsm/waypoint2_x" value="$(arg point2_x)" type="double"/>
        <param name="fsm/waypoint2_y" value="$(arg point2_y)" type="double"/>
        <param name="fsm/waypoint2_z" value="$(arg point2_z)" type="double"/>
        <param name="fsm/waypoint3_x" value="$(arg point3_x)" type="double"/>
        <param name="fsm/waypoint3_y" value="$(arg point3_y)" type="double"/>
        <param name="fsm/waypoint3_z" value="$(arg point3_z)" type="double"/>
        <param name="fsm/waypoint4_x" value="$(arg point4_x)" type="double"/>
        <param name="fsm/waypoint4_y" value="$(arg point4_y)" type="double"/>
        <param name="fsm/waypoint4_z" value="$(arg point4_z)" type="double"/>
        <param name="grid_map/resolution" value="0.1" />
        <param name="grid_map/map_size_x" value="$(arg map_size_x_)" />
        <param name="grid_map/map_size_y" value="$(arg map_size_y_)" />
        <param name="grid_map/map_size_z" value="$(arg map_size_z_)" />
        <param name="grid_map/local_update_range_x" value="5.5" />
        <param name="grid_map/local_update_range_y" value="5.5" />
        <param name="grid_map/local_update_range_z" value="2.0" /> <!-- different meaning between grid_map.cpp and grid_map_bigmap.cpp -->
        <param name="grid_map/obstacles_inflation" value="0.1" />
        <param name="grid_map/local_map_margin" value="10"/>
        <param name="grid_map/enable_virtual_wall" value="true"/>
        <param name="grid_map/virtual_ceil" value="3.0"/>
        <param name="grid_map/virtual_ground" value="-0.1"/>
        <param name="grid_map/ground_height" value="-0.01"/>
        <!-- camera parameter -->
        <param name="grid_map/cx" value="$(arg cx)"/>
        <param name="grid_map/cy" value="$(arg cy)"/>
        <param name="grid_map/fx" value="$(arg fx)"/>
        <param name="grid_map/fy" value="$(arg fy)"/>
        <!-- depth filter -->
        <param name="grid_map/use_depth_filter" value="true"/>
        <param name="grid_map/depth_filter_tolerance" value="0.15"/>
        <param name="grid_map/depth_filter_maxdist" value="5.0"/>
        <param name="grid_map/depth_filter_mindist" value="0.2"/>
        <param name="grid_map/depth_filter_margin" value="2"/>
        <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
        <param name="grid_map/skip_pixel" value="2"/>
        <!-- local fusion -->
        <param name="grid_map/p_hit" value="0.65"/>
        <param name="grid_map/p_miss" value="0.35"/>
        <param name="grid_map/p_min" value="0.12"/>
        <param name="grid_map/p_max" value="0.90"/>
        <param name="grid_map/p_occ" value="0.80"/>
        <param name="grid_map/fading_time" value="1000.0"/>
        <param name="grid_map/min_ray_length" value="0.1"/>
        <param name="grid_map/max_ray_length" value="4.5"/>
        <param name="grid_map/visualization_truncate_height" value="1.9"/>
        <param name="grid_map/show_occ_time" value="false"/>
        <param name="grid_map/pose_type" value="1"/>
        <param name="grid_map/frame_id" value="world"/>
        <!-- planner manager -->
        <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="manager/polyTraj_piece_length" value="1.5" type="double"/>
        <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
        <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <param name="manager/use_multitopology_trajs" value="$(arg use_multitopology_trajs)" type="bool"/>
        <param name="manager/drone_id" value="$(arg drone_id)"/>
        <!-- trajectory optimization -->
        <param name="optimization/constraint_points_perPiece" value="5" type="int"/>
        <param name="optimization/weight_obstacle" value="10000.0" type="double"/>
        <param name="optimization/weight_obstacle_soft" value="5000.0" type="double"/>
        <param name="optimization/weight_swarm" value="10000.0" type="double"/>
        <param name="optimization/weight_feasibility" value="10000.0" type="double"/>
        <param name="optimization/weight_sqrvariance" value="10000.0" type="double"/>
        <param name="optimization/weight_time" value="10.0" type="double"/>
        <param name="optimization/obstacle_clearance" value="0.1" type="double"/>
        <param name="optimization/obstacle_clearance_soft" value="0.5" type="double"/>
        <param name="optimization/swarm_clearance" value="0.15000000000000002" type="double"/> <!-- heterogeneous support: my required clearance -->
        <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="optimization/max_jer" value="$(arg max_jer)" type="double"/>
        <param name="optimization/record_opt" value="true"/>

        <!-- TF-SFC MVP: disabled by default; 0=Frenet, 1=PCA, 2=sensitivity Gramian. -->
        <param name="tf_sfc/enabled" value="$(arg tf_sfc_enabled)" type="bool"/>
        <param name="tf_sfc/corridor_method" value="$(arg tf_sfc_corridor_method)" type="string"/>
        <param name="tf_sfc/use_projection" value="$(arg tf_sfc_use_projection)" type="bool"/>
        <param name="tf_sfc/use_soft_penalty" value="$(arg tf_sfc_use_soft_penalty)" type="bool"/>
        <param name="tf_sfc/allow_partial_corridors" value="$(arg tf_sfc_allow_partial_corridors)" type="bool"/>
        <param name="tf_sfc/allow_ego_fallback" value="$(arg tf_sfc_allow_ego_fallback)" type="bool"/>
        <param name="tf_sfc/enforce_final_corridor" value="$(arg tf_sfc_enforce_final_corridor)" type="bool"/>
        <param name="tf_sfc/hard_corridor_parameterization" value="$(arg tf_sfc_hard_corridor_parameterization)" type="bool"/>
        <param name="tf_sfc/hard_max_vertices" value="$(arg tf_sfc_hard_max_vertices)" type="int"/>
        <param name="tf_sfc/hard_vertex_tolerance" value="$(arg tf_sfc_hard_vertex_tolerance)" type="double"/>
        <param name="tf_sfc/max_enforcement_passes" value="$(arg tf_sfc_max_enforcement_passes)" type="int"/>
        <param name="tf_sfc/enforcement_weight_multiplier" value="$(arg tf_sfc_enforcement_weight_multiplier)" type="double"/>
        <param name="tf_sfc/enforcement_min_improvement" value="$(arg tf_sfc_enforcement_min_improvement)" type="double"/>
        <param name="tf_sfc/max_final_violation" value="$(arg tf_sfc_max_final_violation)" type="double"/>
        <param name="tf_sfc/visualization_enabled" value="$(arg tf_sfc_visualization_enabled)" type="bool"/>
        <param name="tf_sfc/visualization_frame" value="$(arg tf_sfc_visualization_frame)" type="string"/>
        <param name="tf_sfc/min_valid_pieces" value="$(arg tf_sfc_min_valid_pieces)" type="int"/>
        <param name="tf_sfc/direction_mode" value="$(arg tf_sfc_direction_mode)" type="int"/>
        <param name="tf_sfc/allow_direction_fallback" value="$(arg tf_sfc_allow_direction_fallback)" type="bool"/>
        <param name="tf_sfc/log_enabled" value="$(arg tf_sfc_log_enabled)" type="bool"/>
        <param name="tf_sfc/log_directory" value="$(arg tf_sfc_log_directory)" type="string"/>
        <param name="tf_sfc/experiment_tag" value="$(arg tf_sfc_experiment_tag)" type="string"/>
        <param name="tf_sfc/max_faces" value="$(arg tf_sfc_max_faces)" type="int"/>
        <param name="tf_sfc/max_obs_faces" value="$(arg tf_sfc_max_obs_faces)" type="int"/>
        <param name="tf_sfc/samples_per_piece" value="8" type="int"/>
        <param name="tf_sfc/projection_passes" value="4" type="int"/>
        <param name="tf_sfc/safety_margin" value="$(arg tf_sfc_safety_margin)" type="double"/>
        <param name="tf_sfc/min_overlap_radius" value="$(arg tf_sfc_min_overlap_radius)" type="double"/>
        <param name="tf_sfc/interior_sample_margin" value="$(arg tf_sfc_interior_sample_margin)" type="double"/>
        <param name="tf_sfc/junction_refine_radius" value="$(arg tf_sfc_junction_refine_radius)" type="double"/>
        <param name="tf_sfc/junction_refine_step" value="$(arg tf_sfc_junction_refine_step)" type="double"/>
        <param name="tf_sfc/max_inflation_distance" value="$(arg tf_sfc_max_inflation_distance)" type="double"/>
        <param name="tf_sfc/inflation_step" value="$(arg tf_sfc_inflation_step)" type="double"/>
        <param name="tf_sfc/weight" value="1000.0" type="double"/>
        <param name="tf_sfc/penalty_epsilon" value="0.02" type="double"/>
        <param name="tf_sfc/decomp_local_bbox_forward" value="$(arg tf_sfc_decomp_local_bbox_forward)" type="double"/>
        <param name="tf_sfc/decomp_local_bbox_lateral" value="$(arg tf_sfc_decomp_local_bbox_lateral)" type="double"/>
        <param name="tf_sfc/decomp_local_bbox_vertical" value="$(arg tf_sfc_decomp_local_bbox_vertical)" type="double"/>
        <param name="tf_sfc/decomp_overlap_extension" value="$(arg tf_sfc_decomp_overlap_extension)" type="double"/>
        <param name="tf_sfc/decomp_initial_velocity_segment" value="$(arg tf_sfc_decomp_initial_velocity_segment)" type="double"/>
        <param name="tf_sfc/decomp_initial_velocity_threshold" value="$(arg tf_sfc_decomp_initial_velocity_threshold)" type="double"/>
        <param name="tf_sfc/decomp_degenerate_seed_length" value="$(arg tf_sfc_decomp_degenerate_seed_length)" type="double"/>
        <param name="tf_sfc/decomp_retry_seed_validation_without_velocity" value="$(arg tf_sfc_decomp_retry_seed_validation_without_velocity)" type="bool"/>
        <param name="tf_sfc/seed_retry_without_velocity_on_clearance_failure" value="$(arg tf_sfc_seed_retry_without_velocity_on_clearance_failure)" type="bool"/>
        <param name="tf_sfc/seed_clearance_astar_enabled" value="$(arg tf_sfc_seed_clearance_astar_enabled)" type="bool"/>
        <param name="tf_sfc/seed_clearance_astar_time_limit" value="$(arg tf_sfc_seed_clearance_astar_time_limit)" type="double"/>
        <param name="tf_sfc/trajectory_repair_enabled" value="$(arg tf_sfc_trajectory_repair_enabled)" type="bool"/>
        <param name="tf_sfc/trajectory_repair_seed_fallback_enabled" value="$(arg tf_sfc_trajectory_repair_seed_fallback_enabled)" type="bool"/>
        <param name="tf_sfc/trajectory_repair_seed_geometric_acceptance_enabled" value="$(arg tf_sfc_trajectory_repair_seed_geometric_acceptance_enabled)" type="bool"/>
        <param name="tf_sfc/trajectory_repair_max_passes" value="$(arg tf_sfc_trajectory_repair_max_passes)" type="int"/>
        <param name="tf_sfc/post_optimization_repair_enabled" value="$(arg tf_sfc_post_optimization_repair_enabled)" type="bool"/>
        <param name="tf_sfc/post_optimization_repair_max_passes" value="$(arg tf_sfc_post_optimization_repair_max_passes)" type="int"/>
        <param name="tf_sfc/post_optimization_repair_max_seed_junction_shift" value="$(arg tf_sfc_post_optimization_repair_max_seed_junction_shift)" type="double"/>
        <param name="tf_sfc/trajectory_repair_trigger" value="$(arg tf_sfc_trajectory_repair_trigger)" type="double"/>
        <param name="tf_sfc/trajectory_repair_min_improvement" value="$(arg tf_sfc_trajectory_repair_min_improvement)" type="double"/>
    </node>
</launch>
